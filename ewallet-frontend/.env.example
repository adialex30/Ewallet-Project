# Base URL of the Spring Boot backend's API (note: includes /api).
VITE_API_BASE_URL=http://localhost:8080/api

# Midtrans CLIENT key (public, safe to expose in frontend code).
# Never put the SERVER key here - that stays backend-only.
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_WITH_YOUR_CLIENT_KEY

# false = sandbox Snap.js, true = production Snap.js
VITE_MIDTRANS_IS_PRODUCTION=false
